# NeoNatal Watch AI — Environment Variables Template
# Copy this file to .env and configure for your local or hosting environment.
# NEVER commit the real .env to version control.

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=neonatal_watch_ai
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Test Database (Used automatically by pytest fixtures)
TEST_DB_NAME=test_neonatal_watch_ai

# Server & Hosting Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Comma-separated list of allowed origins, or * for development)
# In production, set to your frontend domain, e.g.: https://your-domain.com
CORS_ORIGINS=*
